# ============================================================================================
#  Apixis launch keys — copy this file to .env.launch (same folder), fill in what you have,
#  then run:   npm run launch:check     (see what is missing, changes nothing)
#              npm run launch           (sets everything up)
#
#  .env.launch never leaves your Mac and is never committed (.gitignore). Leave a line empty if
#  you don't have that key yet; run the kit again later, it only adds what is new.
#  You do NOT fill in passwords/secrets the kit can make itself (cron secrets, encryption keys,
#  world keys, Wallet keys) or anything from Supabase — the kit fetches those.
# ============================================================================================

# ---- Access (needed) ----------------------------------------------------------------------
# Vercel → Account Settings → Tokens → Create (scope: your team, no expiry or 1 day is fine).
VERCEL_TOKEN=
# Only if your projects live in a Vercel team and the kit can't find them: Team Settings → Team ID.
VERCEL_TEAM_ID=
# Supabase → Account (top right) → Access Tokens → Generate new token.
# Lets the kit fetch every project's Supabase keys, mint Wallet keys, run the hub SQL and turn on
# leaked-password protection. Without it the kit only sets the keys you type below.
SUPABASE_ACCESS_TOKEN=

# ---- Shared by many sites (type once) ------------------------------------------------------
# console.anthropic.com → API Keys. Powers Cixy everywhere. Top up credits too.
ANTHROPIC_API_KEY=
# resend.com → API Keys. Support forms and notifications.
RESEND_API_KEY=
# Optional: platform.openai.com (Apixis.dev, Socixis, Contraxis, Recovra fallbacks).
OPENAI_API_KEY=
# Optional: console.x.ai (Socixis video, ContentBot clips).
XAI_API_KEY=

# ---- Per company: only the keys that company needs from you -------------------------------

[wallet]
# Stripe (live) → Developers → API keys → Create restricted key: Checkout Sessions read/write, PaymentIntents +
# Charges + Disputes read, Invoices write (only if invoices are on). Details: docs/KEYS.md.
STRIPE_RESTRICTED_KEY=
# Stripe → Developers → Webhooks → endpoint https://apixis-wallet.vercel.app/api/webhooks/stripe → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Stripe → Products → each Ixis pack → Price ID (price_...).
STRIPE_IXIS_SPARK_PRICE_ID=
STRIPE_IXIS_STARTER_PRICE_ID=
STRIPE_IXIS_STUDIO_PRICE_ID=
STRIPE_IXIS_EMPIRE_PRICE_ID=

[apixis]
# Vercel → Storage → create an Upstash Redis (KV) store, then copy its REST URL + token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: Plaid bank linking.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=

[renoxis]
# Optional (Gmail/Calendar connect): Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: https://renoxis.dev/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

[socixis]
# Optional (Instagram/Facebook publishing): developers.facebook.com → your app.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Optional video/image providers.
HEYGEN_API_KEY=
DID_API_KEY=
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=

[recovra]
# Shown in the legal footer.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_GOVERNING_LAW=

[lyrixis]
# A Redis URL (e.g. Upstash, rediss://...) for the upload queue.
REDIS_URL=
# Speech-to-text provider (Whisper-compatible): key, and if not OpenAI the base URL + model.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_BASE_URL=
TRANSCRIPTION_MODEL=

[qahwahworld]
# Physical coffee (approved Stripe exception, D14).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

[halaxis]
# tavily.com → API key (research).
TAVILY_API_KEY=

[launchixis]
# Comma-separated admin emails.
ADMIN_EMAILS=

[nurserytoons]
OWNER_ADMIN_EMAIL=

[pinixis]
ADMIN_EMAIL=
FACTORY_EMAILS=
QUOTES_EMAIL=
SUPPORT_EMAIL=
# Pinixis's own Stripe (D17). Stripe → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=
# Stripe → Webhooks → endpoint https://<pinixis domain>/api/stripe/webhook → Signing secret.
STRIPE_WEBHOOK_SECRET=

[awad-command]
ALLOWED_EMAIL=
ELEVENLABS_API_KEY=
CIXY_VOICE_ID=

# ---- Only if the kit says it found several Vercel projects for one company ------------------
[vercel]
# contraxis=contraxis-dev
