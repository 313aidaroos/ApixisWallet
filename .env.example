NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose. Also accepted as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
ALLOWED_EMAIL=awad@apixis.dev
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IXIS_SPARK_PRICE_ID=
STRIPE_IXIS_STARTER_PRICE_ID=
STRIPE_IXIS_STUDIO_PRICE_ID=
STRIPE_IXIS_EMPIRE_PRICE_ID=
# Optional exact hostnames for post-pay return_url. No wildcards.
# CHECKOUT_RETURN_HOSTS=
# Terms the customer accepts at checkout; bump when the terms page changes (stored on every purchase record).
TERMS_VERSION=
# Stripe Checkout options (see AGENTS.md §4b): require a terms checkbox / create a Stripe invoice per purchase.
# STRIPE_REQUIRE_TERMS=false
# STRIPE_CREATE_INVOICES=false
# Random string; Vercel Cron sends it as a bearer to /api/cron/release-holds.
CRON_SECRET=
# Sister sites used to authenticate with SUPABASE_SECRET_KEY itself. Set to false once every site
# has its own apx_ key (npm run api-key -- --name <site> --apps <app>).
# WALLET_ALLOW_LEGACY_SERVICE_KEY=true
# Closed-loop credits. Only `demo` or `live`. Unset means demo. Do not set live until counsel clearance.
# Hard mint cap is the code constant IXIS_MAX_SUPPLY (1_000_000_000_000). It is not set here and is not pre-minted.
# IXIS_ASSET_MODE=demo
# Read-only owner stats for AWAD COMMAND (GET /api/v1/admin/summary). Random, 32+ chars.
# Set the SAME value as WALLET_STATS_KEY on the AWAD COMMAND Vercel project. Not a money key.
WALLET_STATS_KEY=

# ── Added 2026-09-25: keys the code reads that were not listed here ──
# Required
# This site's Wallet client name, printed next to WALLET_API_KEY by `npm run family-keys`.
APIXIS_CLIENT_ID=
# Supabase anon/publishable key (browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service_role key. Server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# This site's Apixis Wallet key (apx_live_…). From `npm run family-keys` in ApixisWallet. Server only.
WALLET_API_KEY=
# Optional
# Apixis ID sign-in redirect (only if the Wallet signs in with Apixis ID).
APIXIS_REDIRECT_URI=
# Wallet base URL. Default https://apixis-wallet.vercel.app
APIXIS_WALLET_API_URL=
# Public site URL, e.g. https://<site>.vercel.app
NEXT_PUBLIC_SITE_URL=
# Legacy names (leave unset)
# Legacy name for WALLET_API_KEY. Leave unset.
# APIXIS_WALLET_API_KEY=
# Legacy name for STRIPE_IXIS_AGENT_PRICE_ID. Leave unset.
# STRIPE_XP_AGENT_PRICE_ID=
# Legacy name for STRIPE_IXIS_BUSINESS_PRICE_ID. Leave unset.
# STRIPE_XP_BUSINESS_PRICE_ID=
# Legacy name for STRIPE_IXIS_OFFICE_PRICE_ID. Leave unset.
# STRIPE_XP_OFFICE_PRICE_ID=
# Legacy name for STRIPE_IXIS_SPARK_PRICE_ID. Leave unset.
# STRIPE_XP_SPARK_PRICE_ID=
